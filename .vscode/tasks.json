// .vscode/tasks.json
{
    // Use the Tasks v2.0.0 schema
    "version": "2.0.0",
    "tasks": [
        {
            // Default build task — replace the command with your project's build command
            "label": "Build",
            "type": "shell",
            "command": "dotnet run ${file}",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "dotnet-build-single-file",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "compile",
                "${file}",
                "-o",
                "bin"
            ],
            "problemMatcher": []
        }
    ]
}